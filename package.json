{
  "name": "dsh-session-delete",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Permanently delete stored DeepSeek Harness sessions from the sidebar Session menu or the session_delete tool.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "session",
    "delete"
  ],
  "license": "MIT",
  "author": "Dennis Hans",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/banner.png",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ningyizhu0/dsh-session-delete.git"
  },
  "homepage": "https://github.com/ningyizhu0/dsh-session-delete#readme",
  "bugs": {
    "url": "https://github.com/ningyizhu0/dsh-session-delete/issues"
  }
}
